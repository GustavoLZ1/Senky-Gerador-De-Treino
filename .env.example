# Copie este arquivo para .env e preencha com os seus dados
# (o arquivo .env NÃO deve ser enviado ao GitHub)

# Porta em que o site vai rodar
PORT=3000

# Texto longo e aleatório usado para proteger as sessões de login
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio

# ---------- SQL Server ----------
# Nome do computador/servidor onde o SQL Server está instalado
DB_SERVER=NOME_DO_SEU_SERVIDOR

# Só se usar instância nomeada (ex.: SQLEXPRESS). Senão, deixe comentado
# DB_INSTANCE=SQLEXPRESS

# Só se usar porta fixa. Não use junto com DB_INSTANCE
# DB_PORT=1433

# Nome do banco de dados
DB_NAME=SENKY

# Usuário e senha do SQL Server criados para o site
DB_USER=seu_usuario_sql
DB_PASSWORD=sua_senha_aqui

# Opções de segurança da conexão
DB_ENCRYPT=true
DB_TRUST_CERT=true